<Window x:Class="ScradaCadeauBonnen_WPF.Keuzes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScradaCadeauBonnen_WPF"
        xmlns:bonnen="clr-namespace:ScradaCadeauBonnen_WPF.Bonnen"
        mc:Ignorable="d"
        Title="Keuzes" Height="530" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="FancyTemplate">
            <Grid>
                <bonnen:FancyBon />
                <Button Content="❌"
                Width="20" Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="Red"
                FontSize="12"
                Cursor="Hand"
                Click="DeleteBon_Click"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ModerneTemplate">
            <Grid>
                <bonnen:ModerneBon />
                <Button Content="❌"
                Width="20" Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="Red"
                FontSize="12"
                Cursor="Hand"
                Click="DeleteBon_Click"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FeestelijkeTemplate">
            <Grid>
                <bonnen:FeestelijkeBon />
                <Button Content="❌"
                Width="20" Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="Red"
                FontSize="12"
                Cursor="Hand"
                Click="DeleteBon_Click"/>
            </Grid>
        </DataTemplate>



    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Scrada"
               FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Thema's" FontSize="16"
               FontWeight="SemiBold" Margin="0,0,0,5"/>

        <Border Grid.Row="2" Grid.Column="0" Background="#F5F5F5"
                CornerRadius="5" Padding="10" Margin="0,0,10,10">
            <ListBox Name="lstThemas" SelectionChanged="lstThemas_SelectionChanged"
                     Background="Transparent" BorderThickness="0"/>
        </Border>


        <Label Grid.Row="3" Grid.Column="0" Content="Kies een bedrag"
               FontWeight="SemiBold" Margin="0,0,0,5"/>

        <StackPanel x:Name="BedragRadioPanel" Grid.Row="4" Grid.Column="0" Margin="10,0">
            <RadioButton Content="€10" Tag="10" GroupName="BedragGroep" Margin="0,5"/>
            <RadioButton Content="€25" Tag="25" GroupName="BedragGroep" Margin="0,5"/>
            <RadioButton Content="€50" Tag="50" GroupName="BedragGroep" Margin="0,5"/>
        </StackPanel>


        <Grid Grid.Row="5" Grid.Column="0" Margin="10,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton Grid.Column="0" GroupName="BedragGroep"
                         VerticalAlignment="Center" Margin="0,0,5,0"/>

            <DockPanel Grid.Column="1">
                <TextBlock Text="Anders: € " VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBox Name="CustomTextBox" Height="25" VerticalContentAlignment="Center"/>
            </DockPanel>
        </Grid>


        <Label Grid.Row="1" Grid.Column="1" Content="Jouw selectie"
               FontWeight="SemiBold" Margin="10,0,0,5"/>


        <Border Grid.Row="2" Grid.Column="1" Grid.RowSpan="6"
        Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="10,0,0,0">
    <Grid>
        <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

        <ContentControl x:Name="ThemaPreview" Height="100" Width="150" Margin="0,0,0,10" Grid.Row="0"/>
        
        <ListBox Name="ItemListBox"
                 Grid.Row="1"
                 SelectionChanged="ItemListBox_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 Background="Transparent"
                 BorderThickness="0"/>
    </Grid>
</Border>
        
        


        <Button Grid.Row="8" Grid.Column="0" Content="Toevoegen" Click="Toevoegen_Click"
                Height="40" Margin="0,10,10,0" Background="#2196F3" Foreground="White"/>

        <Button Grid.Row="8" Grid.Column="1" Content="Betaal" Click="Betaal_Click"
                Height="40" Margin="10,10,0,0" Background="#4CAF50" Foreground="White"/>
    </Grid>
</Window>
