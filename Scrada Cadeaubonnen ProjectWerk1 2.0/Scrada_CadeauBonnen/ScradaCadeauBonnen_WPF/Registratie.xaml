<Window x:Class="ScradaCadeauBonnen_WPF.Registratie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScradaCadeauBonnen_WPF"
        mc:Ignorable="d"
        Title="Registratie" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Label Content="Scrada" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left"/>
                <Label Content="Registreer hier" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="8" Padding="40" Width="500"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Width="420" HorizontalAlignment="Center">
                    <TextBox Name="txtVoornaam" Height="45" Padding="10" Margin="0,0,0,15" 
                             VerticalContentAlignment="Center" Text="Naam"/>

                    <TextBox Name="txtAchternaam" Height="45" Padding="10" Margin="0,0,0,15" 
                             VerticalContentAlignment="Center" Text="Achternaam"/>

                    <TextBox Name="txtEmail" Height="45" Padding="10" Margin="0,0,0,15" 
                             VerticalContentAlignment="Center" Text="E-mail"/>

                    <PasswordBox Name="pwdWachtwoord" Height="45" Padding="10" Margin="0,0,0,15" 
                                 VerticalContentAlignment="Center"/>

                    <PasswordBox Name="pwdBevestigWachtwoord" Height="45" Padding="10" Margin="0,0,0,15" 
                                 VerticalContentAlignment="Center"/>

                    <Button Content="Registreer" FontSize="16" FontWeight="Medium" 
                            Height="45" Margin="0,30,0,0" Background="#4CAF50" Foreground="White"
                            Click="btnRegistreren_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
