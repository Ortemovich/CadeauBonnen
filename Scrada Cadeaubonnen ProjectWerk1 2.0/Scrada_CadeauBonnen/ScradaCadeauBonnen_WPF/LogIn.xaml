<Window x:Class="ScradaCadeauBonnen_WPF.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScradaCadeauBonnen_WPF"
        mc:Ignorable="d"
        Title="LogIn" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Label Content="Scrada" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Label Content="Log in of registreer" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="8" Padding="40" 
                Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Height="382">
            <StackPanel Width="420" HorizontalAlignment="Center">

                <TextBox Name="txtEmail" Height="35" Padding="10" Margin="0,0,0,20" 
                         VerticalContentAlignment="Center" Text="E-mail"/>

                <PasswordBox Name="pwdWachtwoord" Height="35" Padding="10" 
                             VerticalContentAlignment="Center" />

                <Button Content="Bevestig" FontSize="16" FontWeight="Medium" 
                        Height="35" Margin="0,30,0,10" Background="#4CAF50" Foreground="White"
                        Click="btnInloggen_Click"/>

                <Button Content="Registreren" FontSize="16" FontWeight="Medium"
                        Height="35" Background="#2196F3" Foreground="White"
                        Click="btnRegistreren_Click"/>

                <Button Content="coupon link" FontSize="16" FontWeight="Medium"
                        Height="35" Background="Yellow" Margin="0,10,0,10" Foreground="Black" Click="btnLink_Click" />
                
            </StackPanel>
        </Border>
    </Grid>
</Window>
