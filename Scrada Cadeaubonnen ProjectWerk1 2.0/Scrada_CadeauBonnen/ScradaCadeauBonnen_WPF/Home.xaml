<Window x:Class="ScradaCadeauBonnen_WPF.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScradaCadeauBonnen_WPF"
        mc:Ignorable="d"
        Title="Home" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Scrada" FontSize="24" FontWeight="Bold" 
               Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Kopen" Click="Kopen_Click" 
                    Height="60" Width="250" Margin="0,10" Background="#4CAF50" Foreground="White"/>

            <Button Content="Jouw Bestellingen" Click="Bestellingen_Click" 
                    Height="60" Width="250" Margin="0,10" Background="#2196F3" Foreground="White"/>

            <Button Content="Jouw Cadeaubonnen" Click="Cadeaubonnen_Click" 
                    Height="60" Width="250" Margin="0,10" Background="#FF9800" Foreground="White"/>
            <Button x:Name="btnAdminManagement" Content="Admin Management" Click="AdminManagement_Click" 
                    Height="60" Width="250" Margin="0,10" Background="Red" Foreground="White" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>