<UserControl x:Class="ScradaCadeauBonnen_WPF.Bonnen.ModerneBon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScradaCadeauBonnen_WPF.Bonnen"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Border CornerRadius="8" Background="#F5F5F5" Margin="5">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.3" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2196F3" CornerRadius="8,8,0,0" Padding="15,10">
                    <Grid>
                        <TextBlock Text="SCRADA CADEAUBON" FontWeight="SemiBold" FontFamily="Segoe UI" 
                                   Foreground="White" HorizontalAlignment="Left" FontSize="14"/>
                        <TextBlock Text="{Binding AmountDisplay}" FontWeight="Bold" FontFamily="Segoe UI" 
                                   Foreground="White" HorizontalAlignment="Right" FontSize="22"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Code" Foreground="#757575" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding BonCode}" Foreground="#212121" FontWeight="SemiBold" 
                                       FontSize="16" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>

                    

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding ValidUntilDisplay}" FontFamily="Segoe UI" Foreground="#616161" 
                                   HorizontalAlignment="Left" FontSize="12"/>
                        <Border Background="#2196F3" CornerRadius="4" Padding="8,4" 
                                HorizontalAlignment="Right">
                            
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
