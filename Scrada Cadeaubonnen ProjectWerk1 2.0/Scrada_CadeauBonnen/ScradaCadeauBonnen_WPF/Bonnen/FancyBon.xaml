<UserControl x:Class="ScradaCadeauBonnen_WPF.Bonnen.FancyBon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScradaCadeauBonnen_WPF.Bonnen"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
            >
    
    <UserControl.Resources>
        <Style x:Key="ElegantTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Palatino Linotype"/>
            <Setter Property="Foreground" Value="#2D2D2D"/>
        </Style>
    </UserControl.Resources>
    
    

    <Grid>
        <Border Margin="5" CornerRadius="0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.3"/>
            </Border.Effect>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FCFAF7" Offset="0.0"/>
                    <GradientStop Color="#F8F5F1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border BorderThickness="1" Margin="10">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D4B684" Offset="0.0"/>
                        <GradientStop Color="#B3935E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid>
                    

                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="SCRADA CADEAUBON" Style="{StaticResource ElegantTextBlockStyle}" 
                                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"
                                       Foreground="#8A6E3F"/>

                            <Border Height="1" Width="150">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0.0"/>
                                        <GradientStop Color="#D4B684" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        
                        <Grid Grid.Row="1" Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                <TextBlock Text="{Binding BonCode}" Style="{StaticResource ElegantTextBlockStyle}" 
                                           FontFamily="Consolas" TextAlignment="Right" Margin="0,10,0,0"
                                           FontSize="14" Foreground="#8A6E3F"/>

                                
                            </StackPanel>

                            <Border Grid.Column="1" Width="80" Height="80" CornerRadius="40" BorderThickness="1" 
                                    BorderBrush="#D4B684" Margin="15,0,0,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FCFAF7" Offset="0.0"/>
                                        <GradientStop Color="#F5F0E8" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Border.Background>

                                <TextBlock Text="{Binding AmountDisplay}" Style="{StaticResource ElegantTextBlockStyle}" 
                                           FontSize="24" FontWeight="Bold" VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" Foreground="#8A6E3F"/>

                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Border Height="1" Margin="0,0,0,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0.0"/>
                                        <GradientStop Color="#D4B684" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{Binding ValidUntilDisplay}" Style="{StaticResource ElegantTextBlockStyle}" 
                                           FontSize="12" HorizontalAlignment="Center"
                                           Foreground="#8A6E3F"/>

                                
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>

</UserControl>
